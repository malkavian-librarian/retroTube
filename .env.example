# Copy to .env for local development. Railway injects these directly in
# production — see _docs/arch.md and _docs/tasks.md Task 18.

# Required in production (DEBUG=False); optional locally (sane dev defaults apply).
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
# Omit locally to fall back to a SQLite file (db.sqlite3) for zero-setup dev/test runs.
DATABASE_URL=

# Redis connection string, e.g. redis://localhost:6379
# Omit locally to fall back to Channels' in-memory layer (single-process only).
REDIS_URL=
